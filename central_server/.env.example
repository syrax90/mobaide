# Central Server Configuration
# Copy to .env and fill in required values.

# --- Required ---

# Secret key for signing JWTs (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=

# --- Optional ---

# Admin seeding (creates admin user on first startup if no user with this email exists)
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=your-secure-password

# Google OAuth (enables POST /api/auth/google for Android Credential Manager)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Sign in with Apple, native (enables POST /api/auth/apple for the iOS app).
# The iOS app's bundle id, expected as the `aud` claim of Apple identity tokens.
# APPLE_CLIENT_ID=com.mobaide.app

# Sign in with Apple, browser (enables the Apple button on the SPA).
# The Apple *Services ID* — browser identity tokens carry it as
# `aud` instead of the bundle id above, and /api/auth/apple accepts either.
# It must be configured in the Apple developer portal with APPLE_CLIENT_ID as
# its primary App ID: that grouping is what makes Apple issue the same `sub`
# on web as on iOS, so a user who signed up in the app lands on the same
# account here. A standalone Services ID creates duplicate accounts silently.
# See "Sign in with Apple on the web" in docs/deployment.md.
# APPLE_WEB_CLIENT_ID=com.mobaide.web

# Interactive OpenAPI docs (/docs, /redoc, /openapi.json). Off by default —
# the schema is a complete map of every route, parameter and model, including
# the admin dashboard and the release-publishing endpoint, so it stays
# unpublished. When set, the three routes exist but require an admin session
# (the /dashboard/login cookie, or an admin Bearer token); everyone else gets
# a 404, so enabling this never re-exposes the schema publicly.
# ENABLE_API_DOCS=1

# Content-Security-Policy enforcement mode. Unset (the default) enforces:
# violating subresources are blocked. Set to 1 and the server emits
# Content-Security-Policy-Report-Only instead, so violations are reported to the
# browser console and nothing is blocked — for the account-deletion pages, the
# dashboard and the API surfaces. The marketing pages keep their enforcing
# policy either way; it already shipped in production, so there is nothing to
# learn from soaking it.
#
# Enforce is the default on purpose: a report-only default protects nobody if
# the flag is never flipped back. This is meant to be set for exactly ONE deploy
# while you walk the surfaces with devtools open, then removed. See
# "Security response headers -> Rolling out a CSP change" in docs/deployment.md.
# CSP_REPORT_ONLY=0

# Origin the marketing landing page advertises in its canonical, Open Graph,
# JSON-LD and sitemap URLs (default: https://mobaide.com). Only set this for a
# deployment served from a different hostname — a staging apex, or a self-host.
# Scheme + host (+ optional port), no trailing path; a malformed value falls
# back to the default. This is NOT the relay origin the clients dial (that is
# PUBLIC_BASE_URL, which production points at api.mobaide.com) — using the relay
# origin here would publish the API host as the site's canonical URL.
# SITE_BASE_URL=https://mobaide.com

# Origin of the browser client (default: https://app.mobaide.com). Every "Sign
# in" affordance on the marketing site, and every cross-link on the two public
# account-deletion pages, is built from it — point it at a Vite dev server to
# run the whole site against a local SPA. Same shape rules and same
# fall-back-on-malformed behaviour as SITE_BASE_URL above.
# WEB_APP_BASE_URL=https://app.mobaide.com

# JWT algorithm (default: HS256)
# JWT_ALGORITHM=HS256

# Token TTLs in minutes. All four are finite by default. 0 = never expires:
# the token is issued without an `exp` claim, so a leaked one stays valid
# forever. Use 0 for local development only — the server logs a
# `token_ttl.never_expires` warning at startup whenever one is 0.

# Per-agent mobile access token (default: 60 = 1 hour). Clients refresh it
# shortly before it expires.
# MOBILE_TOKEN_EXPIRE_MINUTES=60

# Per-agent mobile refresh token (default: 43200 = 30 days). It rotates on
# every refresh, so only a device idle for the whole TTL reaches it; that
# device lands on the agent list and re-mints with one tap.
# MOBILE_REFRESH_EXPIRE_MINUTES=43200

# User token the Android and iOS apps sign in with (default: 129600 = 90
# days). The apps cannot refresh it, so this is how often a mobile user
# signs in again. Tokens minted while this was 0 expire this long after
# they were issued.
# DASHBOARD_TOKEN_EXPIRE_MINUTES=129600

# Admin dashboard (/dashboard/login) session (default: 10080 = 7 days).
# Sets both the JWT `exp` and the cookie's Max-Age, and a cookie token
# minted while this was 0 expires this long after it was issued. When 0,
# the JWT has no `exp` and the cookie is a browser session cookie
# (cleared on browser close).
# ADMIN_DASHBOARD_TOKEN_EXPIRE_MINUTES=10080

# Refreshable user sessions — the opt-in a client requests by sending
# `refreshable: true` on /api/auth/{register,login,google,apple,verify-email}.
# Those clients (currently the browser SPA) get a short-lived access token
# plus a rotating refresh token redeemable at POST /api/auth/refresh, instead
# of the DASHBOARD_TOKEN_EXPIRE_MINUTES token above. Clients that do not opt
# in are unaffected. Unlike the TTLs above, 0 is NOT "never expires" here —
# both values are clamped to a minimum of 1.
# USER_SESSION_ACCESS_EXPIRE_MINUTES=15
# USER_SESSION_REFRESH_EXPIRE_MINUTES=43200

# Whether the browser session cookies carry `Secure` (default: true).
# The `__Host-` name prefix requires it, so the two travel together: at true
# the cookies are `__Host-mobaide_refresh` / `__Host-mobaide_signed_in`, at
# false they are the same names without the prefix. Set this to false ONLY for
# local development over plain http, and only if you need Safari — Chrome and
# Firefox already accept `Secure` cookies on http://localhost.
# USER_SESSION_COOKIE_SECURE=true

# SQLite database path (default: central_server.db)
# DB_PATH=central_server.db

# Server host and port (default: 0.0.0.0:9000)
# HOST=0.0.0.0
# PORT=9000

# Log level (default: INFO)
# LOG_LEVEL=INFO

# Log format: "json" or "console" (default: json)
# LOG_FORMAT=json

# TTL (seconds) of the single-use QR pairing nonce minted by
# POST /api/pairing/initiate (default: 120). Production sets 600 so a
# pairing link can survive the human hop from a terminal QR to a browser
# on another device; the nonce is single-use, so the wider window adds
# no replay exposure.
# PAIRING_QR_TOKEN_TTL_SECONDS=120

# Per-client-IP hourly cap on the anonymous POST /api/pairing/initiate
# (default: 120; 0 disables). A healthy unpaired agent calls it once per
# TTL, so the cap only bites an agent stuck in a retry loop. Behind a
# proxy it needs FORWARDED_ALLOW_IPS, or every agent shares one bucket.
# PAIRING_INITIATE_IP_HOURLY_CAP=120

# Password sign-in throttle (/api/auth/login, /dashboard/login, and the
# password proof of account deletion). Only wrong passwords count. At the
# cap, even a correct password gets 429 until the window slides past.
# Per-email cap (default: 10), per-client-IP cap (default: 50, not applied
# to the deletion proof), window in seconds (default: 900). 0 disables a
# cap. Behind a proxy the IP cap needs FORWARDED_ALLOW_IPS, or all users
# share one bucket.
# LOGIN_EMAIL_FAILURE_CAP=10
# LOGIN_IP_FAILURE_CAP=50
# LOGIN_FAILURE_WINDOW_SECONDS=900

# WebSocket ping interval in seconds (default: 20)
# WS_PING_INTERVAL=20

# Comma-separated browser origins allowed to open relay WebSockets
# (default: https://app.mobaide.com). Native clients and the agent send
# no Origin header and are always admitted; loopback origins (localhost,
# 127.0.0.1, [::1] — any port) are always allowed for local dev servers.
# Malformed entries are dropped; an all-invalid list falls back to the
# default.
# WS_ALLOWED_ORIGINS=https://app.mobaide.com

# Agent disconnect timeout in seconds (default: 30)
# AGENT_DISCONNECT_TIMEOUT=30

# How often (seconds) in-memory agent heartbeats are flushed to the DB
# in one batched transaction (default: 60)
# HEARTBEAT_FLUSH_INTERVAL_SECONDS=60

# Cadence (seconds) of the monitoring.sample capacity log line: event-loop
# lag, cgroup RSS vs cap, open fds, routing gauges, send-queue drop
# counters (default: 60)
# MONITORING_INTERVAL_SECONDS=60

# --- SMTP (for email verification) ---

# SMTP host — use `mailpit` (compose service) in dev, a real provider in prod
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# SMTP_STARTTLS=false
# SMTP_FROM_ADDRESS=no-reply@mobaide.local
# SMTP_FROM_NAME=Mobaide
# SMTP_FROM_DOMAIN=mobaide.local

# --- Email verification ---

# Require OTP verification before issuing a JWT on register / login.
# Set to `false` in CI or when running without a configured SMTP.
# EMAIL_VERIFICATION_REQUIRED=true

# OTP lifetime in minutes (default: 15)
# EMAIL_VERIFICATION_TTL_MINUTES=15

# How many wrong attempts before invalidating the code (default: 5)
# EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Minimum seconds between resend requests for the same email (default: 60)
# EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Max resends per email per rolling hour (default: 3)
# EMAIL_VERIFICATION_RESEND_HOURLY_CAP=3

# Max /register + /resend-verification calls per client IP per rolling hour,
# shared by both endpoints (default: 20; 0 disables)
# EMAIL_VERIFICATION_IP_HOURLY_CAP=20

# --- Release / agent manifest publishing ---
#
# Required only on the production server that `deploy/prod/release_agent.py`
# publishes to. Without these set, POST /api/internal/agent_manifest returns
# HTTP 503 ("Manifest publishing is disabled") and every release_agent.py run
# fails at its publish step.

# Bearer token accepted in the X-Release-Token header on
# POST /api/internal/agent_manifest. MUST hold the same string as
# `agent/release-token` in the operator's local release key folder, which
# `deploy/prod/release_agent.py` reads. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# RELEASE_AUTH_TOKEN=

# Base64-encoded Ed25519 public key. Two roles:
#   1. The manifest store verifies posted manifests against this key
#      before persisting them.
#   2. `GET /api/v1/agent/trust_key` exposes this value so the agent
#      install scripts and `mobaide-agent fetch-trust-key` can bootstrap
#      the agent-side `<prefix>/trust/central_server.pub` without
#      operator-side env vars on each install host.
# MUST be the public half of `agent/manifest-signing-key` in the
# operator's local release key folder. If unset:
#   - manifests are stored without signature verification (agents with
#     a pinned trust key reject at update time anyway), AND
#   - the trust-key endpoint returns 503, blocking agent installs that
#     rely on auto-bootstrap.
# MANIFEST_SIGNING_PUBLIC_KEY=

# Path to the on-disk manifest record (default: data/agent_manifest.json,
# which lands inside the central-server-data Docker volume).
# MANIFEST_STORE_PATH=data/agent_manifest.json

# Directory for the agent tarballs and wheels that release_agent.py uploads
# and agents download (default: data/agent_releases, same volume).
# AGENT_RELEASE_DIR=data/agent_releases

# --- APNs push (optional, CLA-106) ---
#
# Token-based APNs auth for session-attention alert pushes to iOS devices
# without a live user-events WebSocket. When any of the first four values
# is unset, the push dispatcher is disabled (no errors, WebSocket-only
# delivery) — dev environments without Apple keys need none of these.

# Path to the APNs Auth Key (.p8) downloaded from the Apple Developer portal,
# as seen by the server process. Under the prod compose the host's
# /opt/mobaide/secrets/ is bind-mounted read-only at /app/secrets, so use the
# container path — a host path resolves to nothing inside the container, and an
# unreadable path raises at startup rather than disabling push.
# APNS_KEY_PATH=/app/secrets/AuthKey_ABC123DEFG.p8

# The 10-character Key ID of that .p8 key.
# APNS_KEY_ID=ABC123DEFG

# Apple Developer Team ID.
# APNS_TEAM_ID=TEAM123456

# APNs topic = the iOS app's bundle id.
# APNS_TOPIC=com.mobaide.app

# Default APNs host for device rows without a stored push_environment
# (devices registered via the push-token endpoint carry their own).
# true = api.sandbox.push.apple.com, false = api.push.apple.com.
# APNS_USE_SANDBOX=false

# --- Google Ads offline conversion upload (optional) ---
#
# Uploads one "Agent paired" click conversion per account the first time it
# pairs an agent, keyed on the gclid/gbraid/wbraid the landing page captured
# at sign-up (or, when there is none or the click is older than 90 days, on
# the SHA-256 of the account email). Goes through the Data Manager API, so
# there is no developer token. Disabled unless all five credentials/ids
# below are set; a partial set logs `ads.misconfigured missing=...` at startup
# and stays disabled. See "Google Ads conversion upload" in docs/deployment.md.

# The Ads account that owns the conversion action (the Data Manager API's
# operating account must be the conversion customer itself, not a parent).
# Dashes are optional.
# GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# Manager (MCC) account the OAuth user reaches the account through. Required
# whenever access is via a manager; leave unset when the user is a direct
# member of GOOGLE_ADS_CUSTOMER_ID.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Desktop-type OAuth client (Google Cloud Console > Credentials, on a project
# with the Data Manager API enabled) and the refresh token minted with
# deploy/prod/google_ads_oauth.py for the datamanager scope. The consent
# screen must be "In production" or the refresh token expires after 7 days.
# GOOGLE_ADS_OAUTH_CLIENT_ID=
# GOOGLE_ADS_OAUTH_CLIENT_SECRET=
# GOOGLE_ADS_OAUTH_REFRESH_TOKEN=

# Numeric id of the "Agent paired" conversion action (Goals > Conversions >
# Summary > the action; the number after `ctId=` in the URL).
# GOOGLE_ADS_CONVERSION_ACTION_ID=

# The conversion action's click-through window in days (Google's default is
# 30; the rollout plan configures 90). A click older than this is skipped in
# favour of the hashed-email fallback. 1..90 — capped by the 90-day retention.
# GOOGLE_ADS_CLICK_WINDOW_DAYS=90
