# Central Server Configuration
# Copy to .env and fill in required values.

# --- Required ---

# Secret key for signing JWTs (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=

# --- Optional ---

# Admin seeding (creates admin user on first startup if no user with this email exists)
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=your-secure-password

# Google OAuth (enables POST /api/auth/google for Android Credential Manager)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT algorithm (default: HS256)
# JWT_ALGORITHM=HS256

# Mobile access token TTL in minutes (default: 1440 = 24 hours)
# MOBILE_TOKEN_EXPIRE_MINUTES=1440

# Mobile refresh token TTL in minutes (default: 10080 = 7 days)
# MOBILE_REFRESH_EXPIRE_MINUTES=10080

# Dashboard token TTL in minutes (default: 480 = 8 hours)
# DASHBOARD_TOKEN_EXPIRE_MINUTES=480

# SQLite database path (default: central_server.db)
# DB_PATH=central_server.db

# Server host and port (default: 0.0.0.0:9000)
# HOST=0.0.0.0
# PORT=9000

# Log level (default: INFO)
# LOG_LEVEL=INFO

# Log format: "json" or "console" (default: json)
# LOG_FORMAT=json

# Pairing token TTL in seconds (default: 300 = 5 minutes)
# PAIRING_TOKEN_TTL_SECONDS=300

# WebSocket ping interval in seconds (default: 20)
# WS_PING_INTERVAL=20

# Agent disconnect timeout in seconds (default: 30)
# AGENT_DISCONNECT_TIMEOUT=30

# --- SMTP (for email verification) ---

# SMTP host — use `mailpit` (compose service) in dev, a real provider in prod
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# SMTP_STARTTLS=false
# SMTP_FROM_ADDRESS=no-reply@claude-mobile.local
# SMTP_FROM_NAME=Claude Mobile
# SMTP_FROM_DOMAIN=claude-mobile.local

# --- Email verification ---

# Require OTP verification before issuing a JWT on register / login.
# Set to `false` in CI or when running without a configured SMTP.
# EMAIL_VERIFICATION_REQUIRED=true

# OTP lifetime in minutes (default: 15)
# EMAIL_VERIFICATION_TTL_MINUTES=15

# How many wrong attempts before invalidating the code (default: 5)
# EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Minimum seconds between resend requests for the same email (default: 60)
# EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Max resends per email per rolling hour (default: 3)
# EMAIL_VERIFICATION_RESEND_HOURLY_CAP=3
