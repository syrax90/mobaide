// iOS app version. release-please owns both lines (release-please-config.json
// "ios" package and .github/workflows/release-please.yml): the release PR
// bumps MARKETING_VERSION by one patch and CURRENT_PROJECT_VERSION by one.
// A minor or major bump needs a `Release-As:` commit footer on a commit that
// touches ios/ (see docs/versioning-and-updates.md).
MARKETING_VERSION = 1.1.3 // x-release-please-version
CURRENT_PROJECT_VERSION = 27
