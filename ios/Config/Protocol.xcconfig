// Wire-protocol constants shared with android/app/build.gradle.kts and the
// server envelope.py copies. Bump together with PROTOCOL.md ("How to bump").
APP_PROTOCOL_VERSION = 7
MIN_SERVER_PROTOCOL_VERSION = 6

// App version (MARKETING_VERSION / CURRENT_PROJECT_VERSION), bumped by
// release-please.
#include "Version.xcconfig"

// Developer-local overrides (CENTRAL_SERVER_URL, Google client ids) —
// gitignored; copy Local.xcconfig.example to Local.xcconfig to use
// (android/local.properties parity).
#include? "Local.xcconfig"
