# Mobaide Agent — systemd unit (TEMPLATE)
#
# This file is a reference template. The install scripts
# (deploy/install.sh, deploy/setup.sh) render the actual unit at
# /etc/systemd/system/mobaide-agent.service with the resolved values.
#
# If you wire this up by hand, edit the four __PLACEHOLDER__ tokens below
# with the user/group/home that owns your code, then:
#   sudo install -m 0644 deploy/mobaide-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mobaide-agent
#
# DO NOT add ProtectHome=yes — the agent's job is to read/write the user's
# source trees under their $HOME, and that setting would block the core
# use case. ProtectSystem=strict still locks the rest of the filesystem
# read-only; ReadWritePaths below re-grants writes to exactly the two
# paths the agent needs (the user's home for source trees, the install
# prefix for releases / agent.env / projects.json). NoNewPrivileges and
# PrivateTmp complete the residual hardening.

[Unit]
Description=Mobaide Agent (FastAPI/uvicorn)
After=network.target
Wants=network-online.target
# Crash-loop safety net. ExecStart is the launcher wrapper
# (<prefix>/bin/mobaide-agent-launcher.sh, generated by the install
# scripts): it self-heals a missing/corrupt current release venv by
# rolling forward to the newest sibling release before exec, and the
# in-venv launcher rolls back on its third boot attempt within 60s. This
# raises systemd's hard cap to 10 starts in 10 minutes so those recovery
# paths have room to retry before the unit is shut off.
StartLimitBurst=10
StartLimitIntervalSec=600

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=/opt/mobaide
EnvironmentFile=-/opt/mobaide/agent.env
EnvironmentFile=-/opt/mobaide/mobaide_agent/.env
Environment=MOBAIDE_AGENT_PREFIX=/opt/mobaide
Environment=HOME=__RUN_HOME__
# systemd's default PATH (/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin)
# does not include npm-global or user-local bins where the Claude Code CLI
# typically lives. %h is systemd's specifier for the User='s $HOME and is
# expanded at unit-load time.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin:%h/.npm-global/bin:%h/.local/bin
ExecStart=/opt/mobaide/bin/mobaide-agent-launcher.sh
Restart=on-failure
RestartSec=5
RestartForceExitStatus=75
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=__RUN_HOME__ /opt/mobaide
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
