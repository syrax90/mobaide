[Unit]
Description=Claude Mobile Agent (FastAPI/uvicorn)
After=network.target
Wants=network-online.target
# Crash-loop safety net. The launcher rolls back on its third boot
# attempt within 60s; this raises systemd's hard cap to 10 starts in 10
# minutes so the rollback path has room to retry the previous release
# before the unit is shut off.
StartLimitBurst=10
StartLimitIntervalSec=600

[Service]
Type=simple
User=claude-mobile
Group=claude-mobile
WorkingDirectory=/opt/claude-mobile
EnvironmentFile=-/opt/claude-mobile/agent.env
EnvironmentFile=-/opt/claude-mobile/claude_agent/.env
Environment=CLAUDE_AGENT_PREFIX=/opt/claude-mobile
ExecStart=/usr/bin/env bash -c '/opt/claude-mobile/releases/$(cat /opt/claude-mobile/current_version)/venv/bin/python -m claude_mobile.launcher'
Restart=on-failure
RestartSec=5
RestartForceExitStatus=75
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/claude-mobile
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
