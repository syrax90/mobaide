# TLS mode: LetsEncrypt
# Requires: Cloudflare DNS for mobaide.com, www, api and app set to
#           "DNS only" (gray cloud), ports 80 + 443 open in the server
#           firewall.
# Caddy auto-provisions and renews a Let's Encrypt cert via ACME HTTP-01.

# Send www to the apex. Without this block Caddy matches no site for the www
# host and answers its default empty 200, which is what www.mobaide.com did
# before: a bare 200 with a zero-byte body and no `Via: 1.1 Caddy`, because the
# request reached Caddy but never reached a reverse_proxy.
#
# 308 rather than 301 so the method and body survive the redirect.
#
# In this TLS mode Caddy provisions a separate Let's Encrypt cert for this host
# over ACME HTTP-01, so www.mobaide.com needs a DNS record pointing here and
# must be "DNS only" (gray cloud) like the apex.

# HSTS — the `header Strict-Transport-Security` line in both site blocks below.
#
# It lives here, not in the app: central-server is reached over plain HTTP on
# the compose network, and browsers ignore Strict-Transport-Security on a
# non-HTTPS response. Caddy terminates TLS, so this is the only layer that can
# emit it truthfully.
#
# max-age=300 is the FIRST RUNG of a deliberate ratchet, not the target value.
# HSTS is effectively irreversible: once a browser has cached a max-age,
# lowering it only reaches clients that come back before the old one expires, so
# the short rung proves the header is emitted correctly without committing
# anyone to a year. No includeSubDomains (it would bind api.mobaide.com,
# get.mobaide.com on GitHub Pages, and every future subdomain) and no preload.
# The full ladder and the audit it requires are in docs/deployment.md and
# tracked in CLA-172.
#
# Each site block, including the (app_mobaide) snippet below, carries its own
# copy of the header rather than inheriting it from a shared block.

# app.mobaide.com — the browser SPA (web/), served same-origin with the relay
# so CORS never enters the picture. This snippet MUST stay byte-identical in
# Caddyfile.LetsEncrypt and Caddyfile.CloudflareOrigin: the deploy copies
# exactly one of these files to the server whole, so there is no cross-file
# include to share it.
(app_mobaide) {
    header Strict-Transport-Security "max-age=300"
    encode zstd gzip

    # Backend prefixes — same upstream as the apex/api block. Everything the
    # SPA talks to is same-origin: fetch to /api, WebSockets to /ws and
    # /relay, and the /proxy HTTP+WS agent passthrough. The list mirrors
    # web/vite.config.ts's dev proxy — change both together.
    @backend path /api /api/* /ws /ws/* /relay /relay/* /proxy /proxy/*
    handle @backend {
        reverse_proxy central-server:9000 {
            # On a graceful `caddy reload`, keep already-established proxied
            # streams (terminal WebSockets, agent tunnels) alive under the
            # old config for up to this long instead of force-closing them
            # the moment the config swaps. Only reloads benefit — container
            # restarts still drop everything.
            stream_close_delay 5m
        }
    }

    # Everything else is the SPA: static files from the current release
    # symlink, unknown paths rewritten to index.html for client-side routing.
    handle {
        root * /srv/www/current

        # Static files never pass through central_server's security-header
        # middleware, so this block carries its own copies of the universal
        # headers plus the SPA CSP. The script-src hash pins the pre-paint
        # theme-boot inline <script> in web/index.html; editing that script
        # without updating the hash in BOTH Caddyfiles silently disables it
        # (theme flash, nothing worse) — deploy_web.py preflights the match.
        #
        # The accounts.google.com entries are what Google Identity Services
        # needs for the sign-in button, and they mirror what
        # security_headers.portal_csp() already concedes for /portal/*. The
        # style-src 'unsafe-inline' is not optional: the GIS client appends
        # an inline <style> to <head> as it loads, and renderButton({width})
        # emits an inline style= attribute. img-src stays 'self' — the
        # button and its Google logo render inside a cross-origin iframe, so
        # they are governed by Google's policy, not ours.
        #
        # Cross-Origin-Opener-Policy has to stay same-origin-allow-popups:
        # same-origin severs the opener that same sign-in popup posts its
        # credential back through. Permissions-Policy mirrors what
        # security_headers.py serves on /portal/*, FedCM allowance included:
        # the GIS button frame carries allow="identity-credentials-get", and a
        # frame's allow only delegates what the embedding document grants to
        # that origin, so identity-credentials-get=(self) would refuse it and
        # take sign-in down. Both are unconditional here for the same reason
        # the CSP's Google origins are:
        # Caddy cannot read GOOGLE_CLIENT_ID, and the button never mounts when
        # GET /api/version reports no client id.
        header {
            Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-DQjnNfb9BFsBDwtrOfOC9aSi5NaqDDr+KkPgo0PMtbY=' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self'; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
            Cross-Origin-Opener-Policy "same-origin-allow-popups"
            X-Frame-Options "DENY"
            X-Content-Type-Options "nosniff"
            Referrer-Policy "strict-origin-when-cross-origin"
            Permissions-Policy `camera=(), microphone=(), geolocation=(), payment=(), usb=(), identity-credentials-get=(self "https://accounts.google.com")`
        }

        # route {} forces listed order: the cache headers must run AFTER the
        # try_files rewrite so the /assets/* matcher sees the final path.
        route {
            try_files {path} /index.html
            # index.html and unhashed public/ files (favicon.svg) must
            # revalidate on every load so a deploy is visible immediately
            # (file_server's ETag/Last-Modified make that a cheap 304);
            # Vite's content-hashed /assets/* are immutable by construction.
            header Cache-Control "no-cache, must-revalidate"
            header /assets/* Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
    }
}

www.mobaide.com {
    header Strict-Transport-Security "max-age=300"
    redir https://mobaide.com{uri} 308
}

mobaide.com, api.mobaide.com {
    header Strict-Transport-Security "max-age=300"
    encode zstd gzip
    reverse_proxy central-server:9000 {
        # Same rationale as in (app_mobaide): every deploy now runs
        # `caddy reload`, and without this delay a reload would force-close
        # every established native-client WebSocket (agent tunnels, Android/
        # iOS relay sockets) the moment the config swaps.
        stream_close_delay 5m
    }
}

# The SPA host. DNS-only (gray cloud) like every host in this mode; Caddy
# ACME-issues its certificate over HTTP-01 — create the DNS record BEFORE
# deploying, or issuance retries with backoff until it exists.
app.mobaide.com {
    import app_mobaide
}

# Redirect bare IP / unknown Host to a 404 so only requests for mobaide.com get a cert.
:80 {
    respond 404
}
