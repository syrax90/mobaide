# Required — secret key for JWT signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=

# JWT settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=1440

# User store (JSON file path)
USER_STORE_PATH=users.json

# Server bind address
HOST=0.0.0.0
PORT=8000

# Session limits
MAX_SESSIONS=16
SESSION_DISCONNECT_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
