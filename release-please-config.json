{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "separator": "-",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "draft": false,
  "prerelease": false,
  "bootstrap-sha": "5ef2a0ffa5d135fe81819bf53c04186aaab6118f",
  "packages": {
    "mobaide_agent": {
      "release-type": "python",
      "package-name": "mobaide-agent",
      "component": "agent",
      "changelog-path": "CHANGELOG.md"
    },
    "central_server": {
      "release-type": "python",
      "package-name": "central-server",
      "component": "server",
      "changelog-path": "CHANGELOG.md"
    },
    "android": {
      "release-type": "simple",
      "component": "android",
      "changelog-path": "CHANGELOG.md",
      "versioning": "always-bump-patch",
      "extra-files": [
        "app/build.gradle.kts"
      ]
    },
    "web": {
      "release-type": "node",
      "package-name": "mobaide-web",
      "component": "web",
      "changelog-path": "CHANGELOG.md"
    },
    "ios": {
      "release-type": "simple",
      "component": "ios",
      "changelog-path": "CHANGELOG.md",
      "versioning": "always-bump-patch",
      "extra-files": [
        "Config/Version.xcconfig"
      ]
    }
  }
}
