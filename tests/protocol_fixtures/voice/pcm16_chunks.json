  "float_to_pcm16": {
    "rule": "NaN -> 0; v = x * 32768; clamp v to [-32768, 32767]; truncate toward zero",
    "cases": [
      {
        "name": "zeros",
        "input": [
          0.0,
          -0.0
        ],
        "expect": [
          0,
          0
        ]
      },
      {
        "name": "halves",
        "input": [
          0.5,
          -0.5
        ],
        "expect": [
          16384,
          -16384
        ]
      },
      {
        "name": "full_scale",
        "input": [
          1.0,
          -1.0
        ],
        "expect": [
          32767,
          -32768
        ]
      },
      {
        "name": "out_of_range",
        "input": [
          1.5,
          -2.0
        ],
        "expect": [
          32767,
          -32768
        ]
      },
      {
        "name": "truncates_toward_zero",
        "input": [
          4.57763671875e-05,
          -4.57763671875e-05
        ],
        "expect": [
          1,
          -1
        ]
      },
      {
        "name": "largest_below_full_scale",
        "input": [
          0.999969482421875,
          -0.999969482421875
        ],
        "expect": [
          32767,
          -32767
        ]
      },
      {
        "name": "below_one_step",
        "input": [
          1.52587890625e-05
        ],
        "expect": [
          0
        ]
      },
      {
        "name": "non_finite",
        "input": [
          "Infinity",
          "-Infinity",
          "NaN"
        ],
        "expect": [
          32767,
          -32768,
          0
        ]
      }
    ]
  }
