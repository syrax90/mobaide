    {
      "name": "canonical_two_modifiers",
      "token": "ctrl+shift+i",
      "expect": { "ctrl": true, "alt": false, "shift": true, "key": "i" },
      "canonical_token": "ctrl+shift+i"
    },
    {
      "name": "function_key_with_alt",
      "token": "alt+f5",
      "expect": { "ctrl": false, "alt": true, "shift": false, "key": "f5" },
      "canonical_token": "alt+f5"
    },
    {
      "name": "special_key",
      "token": "ctrl+backspace",
      "expect": { "ctrl": true, "alt": false, "shift": false, "key": "backspace" },
      "canonical_token": "ctrl+backspace"
    },
    {
      "name": "modifier_order_on_input_is_free_output_is_canonical",
      "token": "shift+ctrl+a",
      "expect": { "ctrl": true, "alt": false, "shift": true, "key": "a" },
      "canonical_token": "ctrl+shift+a"
    },
    {
      "name": "alt_before_ctrl_renormalizes",
      "token": "alt+ctrl+f5",
      "expect": { "ctrl": true, "alt": true, "shift": false, "key": "f5" },
      "canonical_token": "ctrl+alt+f5"
