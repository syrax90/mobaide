# Auto-generated by `python -m mobaide.agent.config init-env`.
# Re-running the installer never clobbers a paired agent — pass --force
# explicitly to regenerate (RELAY_AGENT_ID/TOKEN are preserved).
#
# This file is the canonical template baked into the wheel. The repo-root
# `mobaide_agent/.env.example` is a generated mirror — regenerate with
# `python -m mobaide.agent.config print-template > mobaide_agent/.env.example`.

# Required — JWT signing key. Generated automatically at install time.
JWT_SECRET_KEY=

# JWT settings
JWT_ALGORITHM=HS256
# JWT TTLs in minutes. 0 = never expires (the JWT is issued without an `exp`
# claim). Pick a positive integer to opt back into expiration.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=0
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=0

# User store (JSON file path)
USER_STORE_PATH=users.json

# Server bind address
HOST=0.0.0.0
PORT=8000

# Session limits
MAX_SESSIONS=16
SESSION_DISCONNECT_TIMEOUT=300

# Logging
LOG_LEVEL=INFO

# --- Claude Code CLI ---
# Absolute path to the Claude Code CLI executable (claude.cmd on Windows,
# claude on POSIX). Set this only if the agent cannot auto-discover the
# binary on PATH — common on hosts where claude is installed outside the
# standard %APPDATA%\npm / ~/.npm-global locations. The Windows
# installer auto-detects and writes this for you; edit or clear this
# line if you reinstall the Claude CLI to a new location.
# MOBAIDE_CLAUDE_BIN=

# --- Codex CLI ---
# Absolute path to the Codex CLI executable (codex.cmd on Windows, codex on
# POSIX). Set this only if the agent cannot auto-discover the binary on PATH —
# it probes the same npm-global locations as Claude. Leave commented to rely on
# PATH / the standard `npm install -g @openai/codex` location. v1 assumes the
# host is already authenticated with Codex.
# MOBAIDE_CODEX_BIN=

# --- Antigravity CLI ---
# Absolute path to the Antigravity CLI executable (agy.exe on Windows, agy on
# POSIX). Set this only if the agent cannot auto-discover the binary on PATH —
# agy is a standalone binary (not npm); the agent additionally probes
# ~/.local/bin and the standard install locations. Leave commented to rely on
# PATH. Authenticate `agy` on the host (Google Sign-In) before launching a
# session — an unauthenticated agy shows its login prompt in the terminal.
# MOBAIDE_AGY_BIN=

# --- Central Server Relay Configuration ---
# Agent dials OUT to the central server over WebSocket. Set RELAY_SERVER_URL
# to enable relay mode. With RELAY_SERVER_URL set but agent id/token empty,
# the agent boots in pairing-pending state and renders a QR for the mobile
# app to scan. The QR is auto-rendered at boot; you can also render it
# on demand:
#     mobaide-agent pair-qr --print     # render once and exit
#     mobaide-agent pair-qr --wait      # render and block until claimed
#     mobaide-agent show-qr             # re-render the most recent pending QR
#     mobaide-agent re-pair             # rotate token, re-pair the same agent (keeps RELAY_AGENT_ID)
#     mobaide-agent re-pair --fresh     # forget this agent and first-pair as a NEW one
#                                       # (use --fresh if pairing 404s: "Re-pair target agent does not exist")

RELAY_SERVER_URL=wss://mobaide.com

# Agent ID and token are populated automatically by the QR pairing flow.
RELAY_AGENT_ID=
RELAY_AGENT_TOKEN=

# Heartbeat interval in seconds (default: 15)
# RELAY_HEARTBEAT_INTERVAL=15

# Reconnect delays in seconds (default: 1.0 base, 60.0 max)
# RELAY_RECONNECT_BASE=1.0
# RELAY_RECONNECT_MAX=60.0

# Uptime (seconds) a relay connection must survive before the reconnect
# backoff resets to the base delay (default: 60.0)
# RELAY_RECONNECT_STABILITY_THRESHOLD=60.0

# --- Linear Auto-Scan Configuration ---
# (Optional — omit PROJECTS to disable auto-scan)

# Projects config as JSON. Each project has a path and Linear API key.
# The Linear filter (trigger labels, trigger states, active/done state, removal
# label) is configured **per project** through the mobile app's project form
# rather than via env vars. Defaults reproduce the historical hardcoded
# behavior (trigger ``Proposals``-state issues with the ``AutoPipeline`` label,
# transition to ``In Progress``, finish at ``Done``, strip ``AutoPipeline``).
# Format: {"ProjectName": {"path": "/abs/path/to/repo", "linear_api_key": "lin_api_..."}}
# PROJECTS={"MyProject": {"path": "/home/user/repos/myproject", "linear_api_key": "lin_api_abc123"}}

# Base directory for git worktrees (relative to project root)
WORKTREE_BASE=claude_worktree

# How often to poll Linear for matching issues (seconds)
SCAN_INTERVAL_SECONDS=300

# Git branch prefix for worktree branches (default: "feature/claude")
BRANCH_PREFIX=feature/claude

# Main branch to create worktrees from
MAIN_BRANCH=main

# Prompt to pass to Claude when launching auto-scan sessions (supports \n for newlines)
# AUTO_SCAN_PROMPT=Read the Linear issue. Resolve the task.

# --- Worktree cleanup (Auto Scan Mode) ---

# When true, auto-scan tracks issues it starts work on in <AGENT_STATE_DIR>/<project>/active_workitems.json
# and removes the git worktree once the issue's Linear state transitions to the
# project's configured ``done_state`` (default: "Done").
AUTO_REMOVE_WORKTREES=true

# Directory (relative to the agent's CWD) for per-project runtime state (active_workitems.json, ...).
AGENT_STATE_DIR=state
