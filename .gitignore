.mcp.json
**/__pycache__
**/.pytest_cache
**/venv/
mobaide_agent/.env
central_server/.env
deploy/prod/.env
deploy/prod/tls/
deploy/prod/*.pem
mobaide_agent/users.json
# Runtime project store — per-project auto-scan config can embed Linear API
# keys; never commit.
mobaide_agent/projects.json
mobaide_agent/state/
**/active_workitems.json
android/app/src/main/res/xml/network_security_config.xml
start-all.ps1
caddy-root.pem
claude_worktree
android/app/src/main/res/raw/caddy_root.crt
config/profiles/*
!config/profiles/_template/
config/.active

# Release artifacts and signing material — never commit
*.aab
*.apk
*.jks
*.keystore
# Python build outputs — release workflows ship whatever is in dist/,
# so a committed stale wheel will replace the freshly-built one.
**/dist/
**/build/
**/*.egg-info/
# pytest-xprocess straggler logs (E2E harness, tests/e2e). Current xprocess+pytest
# store these under .pytest_cache/ (already ignored above); older/standalone
# versions write a top-level .xprocess/. Ignore both.
.xprocess/
android/release.keystore
android/signing.properties
android/app/release/
manifest_signing_key.pem
deploy/get/install.sh.tmp
central_server/data/agent_manifest.json
# Same file shows up at the repo root when tests/manual server runs
# resolve the default `data/agent_manifest.json` from the repo root CWD.
/data/agent_manifest.json
.github/release.keystore
*.DS_Store
